{
    "name": "lasselehtinen/mockingbird-webhook-client",
    "description": "This package receives Mockingbird webhooks and convert them into strongly typed Laravel events.",
    "keywords": [
        "lasselehtinen",
        "laravel",
        "mockingbird-webhook-client"
    ],
    "homepage": "https://github.com/lasselehtinen/mockingbird-webhook-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Lasse Lehtinen",
            "email": "lasse.lehtinen@wsoy.fi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-webhook-client": "^3.7"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Lasselehtinen\\MockingbirdWebhookClient\\": "src/",
            "Lasselehtinen\\MockingbirdWebhookClient\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lasselehtinen\\MockingbirdWebhookClient\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lasselehtinen\\MockingbirdWebhookClient\\MockingbirdWebhookClientServiceProvider"
            ],
            "aliases": {
                "MockingbirdWebhookClient": "Lasselehtinen\\MockingbirdWebhookClient\\Facades\\MockingbirdWebhookClient"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
